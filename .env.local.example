# Set to 1 to enable the Mongo/Sanity backend path in the app UI (otherwise
# the built-in localStorage demo experience is used).
NEXT_PUBLIC_BACKEND_LIVE=0

# Canonical origin used for sitemap.xml, robots.txt, Open Graph and canonical
# URLs. Leave unset during local dev (falls back to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://peoplemaps.app

# ---- MongoDB (all coordination + spots data) ----
# Local:  mongodb://127.0.0.1:27017/peoplemaps
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/peoplemaps
MONGODB_URI=mongodb://127.0.0.1:27017/peoplemaps
MONGODB_DB=peoplemaps
# Optional: MongoDB connection timeout in ms (default 2500).
# MONGODB_TIMEOUT_MS=2500

# ---- Supabase (auth only) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key for browser + cookie-based server auth.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Legacy alias; PUBLISHABLE_KEY takes precedence when both are set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Comma-separated Supabase user UUIDs who get global admin access in the app.
ADMIN_USER_IDS=

# ---- Sanity (user-created map documents only; points go to Mongo) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=YOUR-PROJECT-ID
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
# Read token for the browser/embedded Studio + API routes
SANITY_API_READ_TOKEN=YOUR-READ-TOKEN
# Write token (create/edit map documents). Required for "Create map" in the
# admin UI. Generate a token with write access in Sanity: Settings>API>Tokens.
SANITY_API_WRITE_TOKEN=YOUR-WRITE-TOKEN

# ---- Paddle (paid subscriptions — optional) ----
# Paddle is the merchant of record: it charges the card, handles VAT/tax and
# absorbs dispute risk. Create a sandbox account at https://sandbox-vendors.paddle.com
# (production: https://vendors.paddle.com) and add an API key with at minimum
# transaction.write/read + subscription.read + customer portal session (write).
# Secret key from Developers > Authentication.
PADDLE_API_KEY=
# The Pro subscription price id (e.g. pri_...) from Catalog > Prices.
PADDLE_PRICE_ID=
# sandbox | production — must match the account that issued the API key.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Webhook signing key from Developers > Notifications (the P_{...} value).
# Destination URL: https://localhost:3000/api/billing/webhook (or your domain).
PADDLE_WEBHOOK_SECRET=

# ---- Rate limiting (recommended for production) ----
# Write endpoints are rate limited per requester IP. With these two vars set the
# limits are enforced via Upstash Redis (shared across serverless instances);
# without them an in-process fallback is used (per-instance, single host only).
# Create a free database at https://console.upstash.com and copy the REST URL +
# token from the "REST API" panel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
