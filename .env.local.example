# Set to 1 to enable the Mongo/Sanity backend path in the app UI (otherwise
# the built-in localStorage demo experience is used).
NEXT_PUBLIC_BACKEND_LIVE=0

# ---- MongoDB (all coordination + spots data) ----
# Local:  mongodb://127.0.0.1:27017/peoplemaps
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/peoplemaps
MONGODB_URI=mongodb://127.0.0.1:27017/peoplemaps
MONGODB_DB=peoplemaps

# ---- Supabase (auth only) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Sanity (user-created map documents only; points go to Mongo) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=YOUR-PROJECT-ID
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
# Read token for the browser/embedded Studio + API routes
SANITY_API_READ_TOKEN=YOUR-READ-TOKEN
